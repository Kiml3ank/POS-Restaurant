// POS ร้านอาหาร — Prisma schema
// ขอบเขตของไฟล์นี้ตอนนี้ = บทที่ 3-5, 13 (โครงร้าน + เมนู 3 ชั้น + โต๊ะ/session + ออร์เดอร์ + staff/role)
//
// กฎประจำไฟล์นี้ (จาก CLAUDE.md หัวข้อ 2 และ 4):
//   - ทุกตารางที่ผูกกับร้าน ต้องมี tenantId / branchId ตั้งแต่ตัวแรก ห้ามเติมทีหลัง
//     (รวมถึง OrderItem / Modifier ที่มี branchId ตรงด้วย แม้จะ derive ผ่านความสัมพันธ์ได้
//     ก็ตาม เพื่อให้ query รายงาน/RBAC ต่อสาขาไม่ต้อง join ทุกจุด — ยกเว้นตาราง join ล้วน ๆ
//     ที่ไม่มีคุณค่าต่อการ query แยกสาขา เช่น MenuItemModifierGroup, OrderItemModifier)
//   - จำนวนเงินเก็บเป็น Int หน่วย "สตางค์" เสมอ ห้ามใช้ Float/Decimal แทนเงิน
//   - schema เมนูต้องยืดหยุ่นสามชั้น Item → ModifierGroup → Modifier ห้าม hardcode
//     คอลัมน์ size/topping1/topping2 — ModifierGroup ผูกกับ MenuItem แบบ many-to-many
//     ผ่าน MenuItemModifierGroup เพื่อให้กลุ่มตัวเลือกเดียวกัน (เช่น "ความหวาน") ใช้ซ้ำได้
//     หลายเมนูโดยไม่ต้อง duplicate
//
// นโยบาย onDelete ที่ใช้ทั้งไฟล์:
//   - Cascade  = ใช้ในสายความเป็นเจ้าของล้วน ๆ ที่ยังไม่มีเงินผูกอยู่ (Branch → MenuCategory,
//     Table → TableSession, ModifierGroup → Modifier ฯลฯ)
//   - Restrict = ใช้ทุกจุดที่ชนกับประวัติการเงิน/ออร์เดอร์ (MenuItem/Modifier ที่เคยถูกสั่ง,
//     TableSession → Order) กันลบเมนู/ปิด session แล้วข้อมูลบิลหายหรือถูกลบตาม
//     เมนูที่เลิกขายให้ใช้ isAvailable=false แทนการลบจริง
//   - SetNull  = ใช้กับ field ที่เป็นแค่การ attribution (Staff ที่เปิดโต๊ะ/สั่งออร์เดอร์)
//     พนักงานลาออกแล้วลบบัญชีได้โดยไม่กระทบประวัติออร์เดอร์

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// สถานะออร์เดอร์ — data contract กลางที่ทั้ง 4 หน้าจออ้างอิงร่วมกัน (CLAUDE.md หัวข้อ 1)
/// DRAFT → PLACED → IN_PROGRESS → READY → SERVED → PAID (และ CANCELLED)
enum OrderStatus {
  DRAFT
  PLACED
  IN_PROGRESS
  READY
  SERVED
  PAID
  CANCELLED
}

/// สถานะรายรายการ — KDS ทำงานที่ระดับนี้ เพราะของในบิลเดียวกันเสร็จไม่พร้อมกัน
/// (ครัวร้อนเสิร์ฟช้ากว่าบาร์น้ำ) สถานะของ Order คือผลรวมของรายการในบิล
enum OrderItemStatus {
  DRAFT
  PLACED
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
}

/// ที่มาของออร์เดอร์ — ใช้แยกว่าลูกค้าสั่งเองผ่าน QR หรือพนักงานสั่งแทน
enum OrderChannel {
  CUSTOMER_QR
  POS
}

/// ช่องทางที่ขายของบิลนี้ — เขียนค่าจริงตอนเปิดตะกร้า โดยแปลงมาจาก
/// `RestaurantTable.kind` ของจุดขาย (ดู ORDER_TYPE_FOR_SALE_POINT ใน lib/sale-point.ts)
/// **ห้ามให้หน้าจอส่งค่านี้มา** เพราะเป็นตัวชี้ว่าบิลนี้คิดเซอร์วิสชาร์จหรือไม่
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

/// ชนิดของ "จุดขาย" (แถวใน RestaurantTable) — โต๊ะนั่ง / เคาน์เตอร์ซื้อกลับ / ช่องรับออร์เดอร์แพลตฟอร์ม
///
/// เป็นชนิดของ **จุดขาย** ไม่ใช่ของบิล เพราะกติกาสามข้อผูกกับจุดขาย ไม่ได้ผูกกับออร์เดอร์:
///   1. ขึ้นผังโต๊ะไหม (เฉพาะ DINE_IN)
///   2. รอบใหม่ "เข้าร่วม" รอบที่เปิดค้างอยู่ไหม (เฉพาะ DINE_IN — ดู openOrJoinTableSession)
///   3. คิดเซอร์วิสชาร์จไหม (เฉพาะ DINE_IN — ของกลับบ้านไม่มีบริการที่โต๊ะ)
enum SalePointKind {
  DINE_IN
  COUNTER
  DELIVERY
}

/// สถานะโต๊ะ ณ ปัจจุบัน — ค่าที่หน้า POS ใช้ระบายสีผังโต๊ะ
enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

/// รอบการใช้โต๊ะหนึ่งรอบ (ลูกค้านั่งลง → จ่ายเงินออก)
/// ABANDONED = ปิดทิ้งโดยพนักงานเพราะลูกค้าหายไปโดยไม่ได้จ่าย/ไม่ได้สั่ง
enum TableSessionStatus {
  OPEN
  CLOSED
  ABANDONED

  /// ถูกกลืนเข้ากับรอบอื่นตอน "รวมโต๊ะ" — ไม่ใช่รอบขายที่เกิดขึ้นจริง
  ///
  /// แยกจาก CLOSED (จบด้วยการรับเงิน) และ ABANDONED (พนักงานล้างทิ้ง) เพราะ
  /// รายงานบทที่ 15 ต้องไม่นับค่านี้เป็นหนึ่งรอบขาย ไม่งั้นจำนวนบิลจะเกินความจริง
  ///
  /// ⚠ ค่านี้เพิ่มเข้ามาทีหลัง — ทุก query ที่เขียนเงื่อนไขแบบ "ไม่ใช่ OPEN"
  /// หรือ in: [CLOSED, ABANDONED] ต้องคิดถึงมันด้วยเสมอ และ TypeScript ไม่ฟ้อง
  MERGED
}

/// สกุลเงินที่ระบบรองรับ — บทที่ 10
///
/// เป็น enum ไม่ใช่ String เพราะการเพิ่มสกุลเงินไม่ใช่แค่เปลี่ยนสัญลักษณ์:
/// **จำนวนทศนิยมไม่เท่ากัน** (ดู lib/money.ts) เลขจำนวนเต็มก้อนเดียวกันใน DB
/// จึงแปลว่าคนละมูลค่ากันตามสกุลเงินของสาขา ถ้าปล่อยเป็น String แล้วมีใคร
/// พิมพ์ "thb" หรือ "USD" ลงไป ระบบจะแสดงราคาผิดโดยไม่มีอะไรฟ้อง
///
/// การเพิ่มสกุลใหม่ต้องแก้สองที่เสมอ: enum นี้ + ตารางใน lib/money.ts
/// (TypeScript จะฟ้องเองถ้าเติมที่นี่แล้วลืมอีกที่)
enum Currency {
  /// บาทไทย — มีสตางค์ 2 ตำแหน่ง
  THB
  /// กีบลาว — ไม่ใช้ทศนิยม
  LAK
  /// ดองเวียดนาม — ไม่ใช้ทศนิยม
  VND
}

/// วิธีที่ลูกค้าจ่ายเงิน (บทที่ 11)
///
/// ⚠ **ก้อนนี้เป็นโหมดสาธิต** ระบบไม่ได้ต่อกับ payment gateway จริง ไม่มี webhook
/// และไม่มีการยืนยันยอดจากธนาคาร — แคชเชียร์เป็นคนกดยืนยันเองว่าได้รับเงินแล้ว
/// (ตรงกับความจริงของ "เงินสด" อยู่แล้ว แต่ **ไม่ตรง** สำหรับ QR ซึ่งของจริงต้อง
/// รอ callback จากธนาคาร) วันที่ต่อของจริงต้องเพิ่มสถานะ/reference ของรายการโอน
/// ที่ตารางนี้ ไม่ใช่ไปเพิ่มที่ Order
///
/// วิธีจ่ายผูกกับประเทศของสาขา ไม่ใช่ค่าคงที่ของทั้งระบบ: PromptPay เป็นของไทย
/// ลาวใช้ LAO QR (BCEL One) เวียดนามใช้ VietQR (NAPAS) — ทั้งหมดเป็น EMVCo
/// เหมือนกันแต่คนละ tag/ผู้ให้บริการ จึงเก็บกว้าง ๆ ว่า "QR" ไว้ก่อน
enum PaymentMethod {
  CASH
  QR
  /// ยังไม่เปิดใช้ในก้อนนี้ — บัตรต้องมีเครื่อง EDC/gateway จริงถึงจะมีความหมาย
  CARD
}

/// ชนิดของเอกสารที่ออกให้ลูกค้า (บทที่ 12)
///
/// **ถูก snapshot ลงแถว Receipt ตอนออกใบ ห้าม derive ตอน render**
/// เพราะวันที่กฎหมายเปลี่ยน หรือสาขาเปลี่ยนสกุลเงิน ใบที่พิมพ์ไปแล้วต้องไม่เปลี่ยนหัวตาม
/// (เหตุผลเดียวกับ snapshot อัตรา VAT ทุกตัวในไฟล์นี้)
enum ReceiptKind {
  /// ใบเสร็จรับเงิน/ใบกำกับภาษีอย่างย่อ — เอกสารตามประมวลรัษฎากรของไทย
  /// ใช้กับสาขาสกุล THB เท่านั้น และต้องมีเลขประจำตัวผู้เสียภาษีบนใบ
  TAX_ABB
  /// ใบเสร็จรับเงินธรรมดา — สาขา LAK/VND ที่กฎหมายภาษีไทยไม่ครอบ
  /// **ห้ามมีคำว่า "ใบกำกับภาษี" หรือเลขผู้เสียภาษีไทยบนใบนี้**
  RECEIPT
}

/// บทบาทพนักงาน — ฐานของ RBAC ในบทที่ 13
enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  SERVER
  KITCHEN
}

/// หน้าจอที่ session ใบหนึ่งใช้ได้ (บทที่ 13b)
///
/// ต้องเก็บลง DB เพราะ session ผูกกับ "จอเดียว" มาตั้งแต่บทที่ 8 — ล็อกอินจอครัว
/// ต้องไม่เตะเครื่อง POS ที่เปิดค้างอยู่ในเบราว์เซอร์เดียวกัน หน้า "อุปกรณ์ที่ล็อกอินอยู่"
/// จึงต้องบอกได้ว่าใบไหนเป็นของจอไหน
///
/// ค่าตัวใหญ่ตามระเบียบ enum ของไฟล์นี้ ส่วนฝั่ง TypeScript เป็นตัวเล็ก
/// (StaffScreen ใน lib/rbac.ts) — สะพานเชื่อมสองฝั่งอยู่ที่ Record เดียวใน
/// lib/staff-session-cookie.ts ที่ tsc บังคับให้เติมครบทุกจอ
enum StaffScreenKind {
  POS
  KDS
  ADMIN
}

/// ผู้เช่าระบบ = กิจการ/แบรนด์ร้านอาหาร 1 ราย (อาจมีหลายสาขา)
model Tenant {
  id        String   @id @default(cuid())
  name      String
  /// เลขประจำตัวผู้เสียภาษี 13 หลัก — ใช้ออกใบกำกับภาษีอย่างย่อในบทที่ 12
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  @@map("tenants")
}

/// สาขา — หน่วยที่ผูกกับโต๊ะ/เมนู/ออร์เดอร์/กะ ทั้งหมดในบทถัดไป
model Branch {
  id       String @id @default(cuid())
  tenantId String
  /// รหัสสาขาที่คนอ่านได้ เช่น "HQ", "BR-02" — ไม่ซ้ำภายใน tenant เดียวกัน
  code     String
  name     String

  /// ค่าเซอร์วิสชาร์จ หน่วยเป็น basis point (1000 = 10.00%) — เก็บเป็น Int ห้ามใช้ float
  serviceChargeBp  Int     @default(0)
  /// อัตรา VAT หน่วยเป็น basis point (700 = 7.00%)
  vatRateBp        Int     @default(700)
  /// true = ราคาเมนูรวม VAT แล้ว (คิดแบบถอด VAT ออกทีหลัง)
  pricesIncludeVat Boolean @default(true)

  /// ส่วนลดพนักงาน (บทที่ 13) หน่วย basis point — 1000 = 10.00%
  ///
  /// อยู่ที่ Branch ไม่ใช่ค่าคงที่ในโค้ด ด้วยเหตุผลเดียวกับ serviceChargeBp:
  /// เป็นตัวเลขที่เจ้าของร้านเปลี่ยนได้ และเป็นตัวเลขที่ต้อง **snapshot ลง Payment**
  /// ตอนปิดบิลเพื่อให้ใบเสร็จย้อนหลังพิมพ์เปอร์เซ็นต์ที่ถูกต้อง
  /// **ห้าม snapshot ลง TableSession** — วงจรเดียวกับ VAT/เซอร์วิสชาร์จเป๊ะ ๆ
  /// (อ่านจาก Branch สดตอนบิลยังเปิด → snapshot ตอนปิดบิล) ไม่สร้างกติกาที่สาม
  staffMealDiscountBp Int @default(1000)

  timezone String   @default("Asia/Bangkok")
  currency Currency @default(THB)

  /// ที่อยู่และเบอร์โทรของสถานประกอบการ — ต้องขึ้นบนใบเสร็จ/ใบกำกับภาษีอย่างย่อ (บทที่ 12)
  /// nullable เพราะสาขาที่เพิ่งสร้างยังไม่ได้กรอก แต่ Receipt จะ snapshot ค่า ณ วันที่ออกใบไว้
  /// ในแถวของตัวเองเสมอ — แก้ที่นี่ทีหลังไม่กระทบใบที่ออกไปแล้ว
  addressLine String?
  phone       String?

  /// ข้อความท้ายใบเสร็จที่ร้านตั้งเองได้ เช่น "ขอบคุณที่ใช้บริการ" หรือ Wi-Fi/เบอร์สั่งกลับบ้าน
  ///
  /// null = ใช้ข้อความเริ่มต้นของระบบ (ไม่ใช่ "ไม่มีอะไรเลย") เพราะใบเสร็จที่จบห้วน ๆ
  /// ดูเหมือนพิมพ์ไม่ครบมากกว่าดูเหมือนตั้งใจ — คำเตือนว่าเป็นระบบสาธิตเป็นคนละบรรทัด
  /// และ **ฮาร์ดโค้ดไว้ตลอด แก้จากหน้าตั้งค่าไม่ได้** เพราะเป็นคำเตือนด้านความถูกต้อง
  /// ไม่ใช่ข้อความการตลาดของร้าน
  receiptFooter String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stations         Station[]
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  modifierGroups   ModifierGroup[]
  modifiers        Modifier[]
  tables           RestaurantTable[]
  tableSessions    TableSession[]
  orders           Order[]
  orderItems       OrderItem[]
  staff            Staff[]
  auditLogs        AuditLog[]
  staffSessions    StaffSession[]
  shifts           Shift[]
  loginThrottles   StaffLoginThrottle[]
  payments         Payment[]
  receipts         Receipt[]
  documentCounters DocumentCounter[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ─────────────────────────────────────────────────────────────────────────────
// เมนู (บทที่ 4) — สามชั้น: MenuItem → ModifierGroup → Modifier
// ─────────────────────────────────────────────────────────────────────────────

/// สถานีในครัว เช่น "ครัวร้อน" "บาร์น้ำ" "ของหวาน" — KDS แยกจอตามสถานีนี้ (บทที่ 8)
/// เป็นตารางไม่ใช่ enum เพราะแต่ละสาขาจัดครัวไม่เหมือนกันและเพิ่มสถานีเองได้
model Station {
  id       String @id @default(cuid())
  branchId String
  /// รหัสสั้นที่คนอ่านได้ เช่น "HOT", "BAR" — ไม่ซ้ำภายในสาขา
  code     String
  name     String

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]
  orderItems OrderItem[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("stations")
}

/// หมวดเมนู เช่น "ต้ม" "ผัด" "เครื่องดื่ม"
model MenuCategory {
  id       String @id @default(cuid())
  branchId String
  name     String

  sortOrder   Int      @default(0)
  /// ปิดทั้งหมวดได้ในคลิกเดียว เช่น หมวดอาหารเช้าที่ขายเฉพาะช่วงเช้า
  /// หน้าเมนูลูกค้าต้องกรอง isAvailable=true ทุกชั้น (CLAUDE.md บทที่ 6)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([branchId, sortOrder])
  @@map("menu_categories")
}

/// สินค้าที่สั่งได้เป็นชิ้นเดียว — ราคาเริ่มต้นก่อนบวกส่วนต่างจาก Modifier
model MenuItem {
  id         String  @id @default(cuid())
  branchId   String
  categoryId String
  /// สถานีที่ต้องทำเมนูนี้ — null = ไม่ต้องผ่านครัว (เช่น น้ำเปล่าขวดที่หยิบเอง)
  stationId  String?

  name        String
  description String?
  /// ราคาตั้งต้น หน่วย "สตางค์" — 12000 = 120.00 บาท ห้ามใช้ float (CLAUDE.md หัวข้อ 4)
  basePrice   Int
  imageUrl    String?

  sortOrder   Int      @default(0)
  /// false = ของหมด/เลิกขาย — ใช้ค่านี้แทนการลบแถว เพราะ OrderItem เก่าอ้างถึงอยู่
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category       MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  station        Station?                @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@index([branchId, categoryId, sortOrder])
  @@index([categoryId])
  @@index([stationId])
  @@map("menu_items")
}

/// กลุ่มตัวเลือก เช่น "ขนาด" "ระดับความเผ็ด" "ท็อปปิ้ง"
/// กฎการเลือกอยู่ที่นี่ ไม่ได้ hardcode ไว้ในโค้ดหน้าเมนู
model ModifierGroup {
  id       String @id @default(cuid())
  branchId String
  name     String

  /// true = ลูกค้าต้องเลือกก่อนใส่ตะกร้าได้ (เช่น ขนาดแก้ว)
  required  Boolean @default(false)
  /// จำนวนตัวเลือกขั้นต่ำ/สูงสุดที่เลือกได้ — maxSelect = 1 คือ radio, > 1 คือ checkbox
  minSelect Int     @default(0)
  maxSelect Int     @default(1)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  modifiers Modifier[]
  menuItems MenuItemModifierGroup[]

  @@index([branchId])
  @@map("modifier_groups")
}

/// ตัวเลือกย่อยในกลุ่ม เช่น "แก้วใหญ่ +10 บาท", "เผ็ดน้อย +0"
model Modifier {
  id              String @id @default(cuid())
  branchId        String
  modifierGroupId String
  name            String

  /// ส่วนต่างราคา หน่วย "สตางค์" — เป็นลบได้ (เช่น "ไม่เอาเนื้อ -1000")
  priceDelta Int @default(0)

  sortOrder   Int      @default(0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group      ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItems OrderItemModifier[]

  @@index([branchId])
  @@index([modifierGroupId, sortOrder])
  @@map("modifiers")
}

/// ตาราง join ระหว่างเมนูกับกลุ่มตัวเลือก — many-to-many เพื่อให้กลุ่มเดียวกัน
/// (เช่น "ระดับความหวาน") ผูกกับหลายเมนูได้โดยไม่ต้องสร้างซ้ำทุกเมนู
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  /// ลำดับการแสดงกลุ่มนี้ "เฉพาะในเมนูนี้" — เมนูอื่นเรียงกลุ่มเดียวกันคนละลำดับได้
  sortOrder       Int    @default(0)

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ─────────────────────────────────────────────────────────────────────────────
// โต๊ะและ session (บทที่ 5)
// ─────────────────────────────────────────────────────────────────────────────

/// โต๊ะในร้าน — ชื่อโมเดลเลี่ยงคำว่า `Table` เพราะชนกับคำสงวนของ SQL
model RestaurantTable {
  id       String @id @default(cuid())
  branchId String
  /// ชื่อโต๊ะที่คนเรียก เช่น "A1", "ระเบียง 3" — ไม่ซ้ำภายในสาขา
  name     String

  /// รหัสใน URL ของ QR ปัจจุบัน (/t/[tableCode]) — สุ่มและ "หมุนเปลี่ยนได้"
  /// ต้องไม่ซ้ำทั้งระบบเพราะ resolve จาก URL ตรง ๆ โดยยังไม่รู้สาขา
  /// การพิมพ์ QR ใหม่ = เปลี่ยนค่านี้ ทำให้ QR ใบเก่าที่ลูกค้าถ่ายรูปไว้ใช้ไม่ได้ทันที
  tableCode String @unique

  seats  Int         @default(4)
  status TableStatus @default(AVAILABLE)

  /// โต๊ะนั่ง / เคาน์เตอร์ซื้อกลับ / ช่องไรเดอร์
  ///
  /// จุดขายที่ไม่ใช่ DINE_IN **ไม่ขึ้นผังโต๊ะ** และ `status` ของแถวนั้นไม่มีความหมาย
  /// (เคาน์เตอร์มีหลายบิลเปิดพร้อมกันได้ คำว่า "ไม่ว่าง" จึงตอบอะไรไม่ได้) —
  /// โค้ดที่อัปเดต `status` ต้องเช็ค kind ก่อนเสมอ
  kind SalePointKind @default(DINE_IN)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions TableSession[]
  orders   Order[]

  @@unique([branchId, name])
  @@index([branchId, status])
  @@map("restaurant_tables")
}

/// รอบการใช้โต๊ะหนึ่งรอบ — ชั้นที่กันเคส "ลูกค้าถ่ายรูป QR ไว้แล้วสั่งจากบ้านอีกสามวันถัดมา"
/// เพราะ tableCode อย่างเดียวไม่มีวันหมดอายุ แต่ session มี
model TableSession {
  id       String @id @default(cuid())
  branchId String
  tableId  String

  /// ค่าที่เก็บใน cookie ฝั่งลูกค้า — proxy.ts ตรวจค่านี้ก่อนปล่อยเข้า route ลูกค้า
  token String @unique

  status TableSessionStatus @default(OPEN)
  /// จำนวนลูกค้า — ใช้ทำรายงานยอดขายต่อหัวในบทที่ 15
  pax    Int                @default(1)

  openedAt  DateTime  @default(now())
  /// หมดอายุอัตโนมัติ กันลูกค้าที่กลับบ้านไปแล้วยังสั่งเข้าครัวได้
  expiresAt DateTime
  closedAt  DateTime?

  /// พนักงานที่เปิดโต๊ะให้ — null = ลูกค้าสแกน QR เปิดเอง
  openedByStaffId String?

  // ── เลขคิว (จุดขายที่ไม่ใช่โต๊ะนั่ง) ────────────────────────────────────
  //
  // ซื้อกลับไม่มีชื่อโต๊ะให้เรียกลูกค้า จึงต้องมีเลขคิว และเลขคิว **ไม่ใช่**
  // เลขที่ใบกำกับภาษี: "ต่อเนื่องห้ามขาด" ไม่ใช่ข้อกำหนดของมัน แต่ต้องรีเซ็ต
  // ทุกวัน และต้องสั้นพอที่คนจะตะโกนเรียกได้ ("คิว 12") — จึงห้ามเอา
  // DocumentCounter ของบทที่ 12 มาใช้ซ้ำ เพราะตัวนั้นห้ามรีเซ็ตตลอดกาล
  //
  // queueDay เก็บวันแบบ YYYYMMDD ตาม timezone ของสาขา (ท่าเดียวกับ
  // Order.orderNumber ที่ใช้วันของสาขาไม่ใช่ของเครื่อง server) มีไว้เพื่อให้
  // unique constraint ด้านล่างบังคับได้จริงว่า "หนึ่งวัน หนึ่งสาขา ห้ามมีคิวซ้ำ"
  // ทั้งคู่เป็น null สำหรับโต๊ะนั่ง และค่า NULL ไม่ชนกันเองใน Postgres

  /// วันของเลขคิว "YYYYMMDD" ตาม timezone สาขา — null = โต๊ะนั่ง (ไม่มีคิว)
  queueDay    String?
  /// เลขคิวของวันนั้น เริ่มที่ 1 ทุกวัน — null = โต๊ะนั่ง (ไม่มีคิว)
  queueNumber Int?

  /// ชื่อที่ใช้เรียกลูกค้าตอนของเสร็จ เช่น "คุณเอ" — ไม่บังคับกรอก
  /// เก็บที่รอบขาย ไม่ใช่ที่ Order เพราะหนึ่งรอบขาย = หนึ่งบิล = หนึ่งลูกค้า
  customerName String?

  // ── รวมโต๊ะ (งานค้างจากบทที่ 9) ────────────────────────────────────────
  //
  // รอบที่ถูกกลืนจะ **ไม่มีออร์เดอร์เหลืออยู่เลย** (ย้ายไปรอบปลายทางหมดแล้ว)
  // เก็บตัวชี้ไว้เพื่อสองอย่าง: พามือถือลูกค้าที่ยังถือ cookie ของรอบนี้ไปยัง
  // รอบปลายทาง (ไม่งั้นเขากดเปิดโต๊ะใหม่แล้วเกิดบิลผีที่พนักงานไม่รู้ตัว)
  // และตอบคำถาม "ของโต๊ะนี้ไปรวมที่ไหน" โดยไม่ต้องขุด AuditLog
  //
  // SetNull ไม่ใช่ Restrict: หลักฐานจริงของการรวมอยู่ใน AuditLog ซึ่งเขียน
  // อย่างเดียวและไม่มีใครลบ ถ้าใช้ Restrict ทุกสคริปต์ที่ล้างรอบโต๊ะ
  // (dev:reset-table + smoke ทุกชุด) ต้องเพิ่มลำดับการลบอีกชั้นตลอดไป

  /// รอบที่กลืนรอบนี้ไป — null เสมอสำหรับรอบปกติ **และสำหรับการ "ย้ายโต๊ะ"**
  /// (การย้ายไม่สร้างรอบใหม่ รอบเดิมแค่เปลี่ยน tableId จึงไม่มีโซ่ให้เดิน)
  mergedIntoSessionId String?

  // ── ส่วนลดพนักงาน (บทที่ 13) ──────────────────────────────────────────
  //
  // ส่วนลดพนักงานเป็นช่องโกงคลาสสิก: ติดธง "พนักงานกิน" ทุกบิลแล้วเก็บส่วนต่าง
  // ระบบจึงต้องตอบให้ได้ว่า **ใครกิน** ไม่ใช่แค่ "บิลนี้มีส่วนลด" — และต้องแยก
  // "คนกิน" ออกจาก "คนกด" เพราะแคชเชียร์คิดเงินให้พ่อครัวได้เป็นเรื่องปกติ
  //
  // เก็บที่ TableSession เพราะ **หนึ่งรอบโต๊ะ = หนึ่งบิล** (กฎตั้งแต่บทที่ 10)
  // ส่วนลดเป็นของบิล จึงต้องอยู่ระดับเดียวกันเป๊ะ ไม่ใช่กระจายลงแต่ละ Order
  // (กระจายแล้วปัดเศษหลายรอบ ยอดไม่ตรงกับที่ลูกค้าจ่าย — บทเรียนจากบทที่ 11)

  /// พนักงานที่เป็น "ลูกค้า" ของบิลนี้ — null = บิลลูกค้าปกติ ไม่มีส่วนลด
  staffCustomerId  String?
  /// พนักงานที่กดติดธง — คนละคนกับ staffCustomerId ได้
  staffMealSetById String?
  staffMealSetAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table          RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  openedByStaff  Staff?          @relation(fields: [openedByStaffId], references: [id], onDelete: SetNull)
  /// SetNull: ลบบัญชีพนักงานแล้วบิลเก่าต้องไม่หายตาม — ชื่อคนกินที่ตรวจสอบย้อนหลังได้จริง
  /// อยู่ใน Payment.staffCustomerId (บิลที่ปิดแล้ว) และใน AuditLog
  staffCustomer  Staff?          @relation("StaffMealCustomer", fields: [staffCustomerId], references: [id], onDelete: SetNull)
  staffMealSetBy Staff?          @relation("StaffMealSetBy", fields: [staffMealSetById], references: [id], onDelete: SetNull)
  orders         Order[]
  payments       Payment[]

  /// รอบที่กลืนรอบนี้ไป / รอบที่ถูกรอบนี้กลืนมา (รวมโต๊ะ)
  mergedInto TableSession?  @relation("SessionMerge", fields: [mergedIntoSessionId], references: [id], onDelete: SetNull)
  mergedFrom TableSession[] @relation("SessionMerge")

  /// หนึ่งวัน หนึ่งสาขา ห้ามมีเลขคิวซ้ำ — สองคนที่ได้ "คิว 12" พร้อมกัน
  /// คือเคสที่พนักงานเรียกแล้วมีคนมารับผิดคน จึงกันด้วย constraint ไม่ใช่ด้วยความหวัง
  @@unique([branchId, queueDay, queueNumber])
  @@index([branchId, status])
  @@index([tableId, status])
  /// ใช้บังคับกติกา "หนึ่งคน หนึ่งบิลที่เปิดอยู่" — กันเอาชื่อคนเดียวไปแปะหลายโต๊ะพร้อมกัน
  @@index([staffCustomerId, status])
  /// Postgres ไม่สร้าง index ให้ FK เอง — ใช้ตอนไล่ดูว่ารอบไหนถูกกลืนมารวมที่นี่บ้าง
  @@index([mergedIntoSessionId])
  @@map("table_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ออร์เดอร์ (บทที่ 7)
// ─────────────────────────────────────────────────────────────────────────────

/// บิลหนึ่งใบ — status=DRAFT คือ "ตะกร้า" ที่ยังไม่ส่งเข้าครัว
/// ตะกร้าอยู่ฝั่ง server ตั้งแต่ต้นเพื่อไม่ให้หายตอน refresh (CLAUDE.md บทที่ 7)
model Order {
  id             String  @id @default(cuid())
  branchId       String
  /// null ได้เมื่อเป็นออร์เดอร์กลับบ้านที่ไม่ผูกโต๊ะ
  tableSessionId String?
  /// เก็บโต๊ะซ้ำไว้ตรง ๆ ด้วย เพราะการย้าย/รวมโต๊ะเปลี่ยนค่านี้ได้โดย session เดิมไม่เปลี่ยน
  tableId        String?

  /// เลขบิลที่คนอ่านได้ เดินต่อเนื่องภายในสาขา — ใช้ออกใบกำกับภาษีในบทที่ 12
  orderNumber String

  status  OrderStatus  @default(DRAFT)
  type    OrderType    @default(DINE_IN)
  channel OrderChannel @default(CUSTOMER_QR)

  /// พนักงานที่กดส่งออร์เดอร์ — null = ลูกค้าสั่งเองจากมือถือ
  placedByStaffId String?

  // ── ยอดเงิน: ทุกคอลัมน์เป็น Int หน่วยสตางค์ (CLAUDE.md บทที่ 10) ────────────
  /// ผลรวมของ OrderItem.lineTotal ทั้งบิล ก่อนส่วนลด
  subtotal            Int @default(0)
  discountAmount      Int @default(0)
  /// ลำดับการคิดตามบทที่ 10: (subtotal - discount) → service charge → VAT
  serviceChargeAmount Int @default(0)
  vatAmount           Int @default(0)
  grandTotal          Int @default(0)

  /// snapshot อัตราที่ใช้ตอนปิดบิล — ห้ามอ่านจาก Branch ตอนพิมพ์ใบเสร็จย้อนหลัง
  /// เพราะร้านอาจปรับเซอร์วิสชาร์จ/VAT ไปแล้วหลังบิลนี้ปิด
  serviceChargeBp  Int?
  vatRateBp        Int?
  pricesIncludeVat Boolean?

  /// การรับเงินที่ปิดบิลใบนี้ (บทที่ 11) — null = ยังไม่ได้จ่าย
  /// หลายบิลชี้มาที่ Payment ใบเดียวกันได้ เพราะคิดเงินทีเดียวทั้ง "รอบโต๊ะ"
  paymentId String?

  note String?

  // ── timestamp ของแต่ละสถานะ: ใช้วัดเวลาครัวและทำ audit trail ในบทที่ 13/15 ──
  placedAt     DateTime?
  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  paidAt       DateTime?
  cancelledAt  DateTime?
  /// เหตุผลการยกเลิก — บังคับกรอกในบทที่ 13 เพราะเป็นจุดที่โกงกันบ่อยที่สุด
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch        Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableSession  TableSession?    @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  table         RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  placedByStaff Staff?           @relation(fields: [placedByStaffId], references: [id], onDelete: SetNull)
  payment       Payment?         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@unique([branchId, orderNumber])
  @@index([branchId, status])
  @@index([tableSessionId])
  @@index([branchId, placedAt])
  @@index([paymentId])
  @@map("orders")
}

/// หนึ่งบรรทัดในบิล — many-to-many ระหว่าง Order กับ MenuItem อยู่ที่ตารางนี้
/// ทุกคอลัมน์ที่ลงท้ายด้วย Snapshot คือค่า ณ เวลาที่สั่ง ห้าม join ไปอ่านจากเมนูสด
/// เพราะร้านขึ้นราคา/เปลี่ยนชื่อเมนูแล้วบิลเก่าต้องไม่เปลี่ยนตาม
model OrderItem {
  id         String  @id @default(cuid())
  branchId   String
  orderId    String
  menuItemId String
  /// สถานีที่ต้องทำ ณ เวลาที่สั่ง — KDS กรองด้วยค่านี้ ไม่ต้อง join เมนู
  stationId  String?

  nameSnapshot      String
  /// ราคาต่อหน่วยก่อนบวก modifier หน่วยสตางค์
  unitPriceSnapshot Int
  /// ผลรวมส่วนต่างของ modifier ทุกตัวในบรรทัดนี้ ต่อหนึ่งหน่วย หน่วยสตางค์
  modifierTotal     Int    @default(0)
  quantity          Int    @default(1)
  /// (unitPriceSnapshot + modifierTotal) × quantity — คิดล่วงหน้าเก็บไว้เลย
  /// เพราะรายงานยอดขายบทที่ 15 ต้อง SUM คอลัมน์นี้ตรง ๆ
  lineTotal         Int

  status OrderItemStatus @default(DRAFT)
  note   String?

  startedAt    DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  cancelledAt  DateTime?
  /// ยกเลิกรายการที่ครัวเริ่มทำแล้วต้องบันทึกเหตุผล (บทที่ 9)
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  station   Station?            @relation(fields: [stationId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([branchId, status])
  @@index([stationId, status])
  @@map("order_items")
}

/// ตัวเลือกที่ลูกค้าเลือกจริงในบรรทัดนั้น พร้อม snapshot ชื่อและส่วนต่างราคา
model OrderItemModifier {
  id          String @id @default(cuid())
  orderItemId String
  modifierId  String

  nameSnapshot       String
  /// ส่วนต่างราคา ณ เวลาที่สั่ง หน่วยสตางค์ (เป็นลบได้)
  priceDeltaSnapshot Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  Modifier  @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, modifierId])
  @@index([modifierId])
  @@map("order_item_modifiers")
}

// ─────────────────────────────────────────────────────────────────────────────
// การรับเงิน (บทที่ 11)
// ─────────────────────────────────────────────────────────────────────────────

/// การรับเงินหนึ่งครั้ง = การปิดบิลของ "รอบโต๊ะ" หนึ่งรอบ
///
/// ── ทำไมต้องเป็นตารางแยก ไม่ยัดยอดลง Order ให้จบ ──────────────────────
/// เพราะบิลคิดที่ระดับรอบโต๊ะ (รวม subtotal ทุกใบก่อน แล้วคิดเซอร์วิสชาร์จ/VAT
/// ครั้งเดียว — ดู lib/server/billing.ts) แต่คอลัมน์ยอดเงินอยู่ที่ระดับ Order
/// ซึ่งมีได้หลายใบต่อรอบ **ยอดที่ลูกค้าจ่ายจริงจึงเป็นของแถวนี้ ไม่ใช่ผลบวกของ Order**
/// (ยอดใน Order เป็นส่วนแบ่งที่กระจายลงไปเพื่อทำรายงานแยกช่องทาง — บทที่ 15)
///
/// ตารางนี้ยังเป็นที่ที่บทที่ 12 จะแขวนเลขที่ใบกำกับภาษีอย่างย่อที่ต้องเดินต่อเนื่อง
model Payment {
  id             String @id @default(cuid())
  branchId       String
  tableSessionId String

  method   PaymentMethod
  /// snapshot สกุลเงิน ณ เวลาที่จ่าย — ห้ามอ่านจาก Branch ตอนพิมพ์ใบเสร็จย้อนหลัง
  /// (สาขาย้ายประเทศไม่ได้ก็จริง แต่ข้อมูลที่ตีความยอดเงินต้องติดอยู่กับยอดเสมอ)
  currency Currency

  // ── ยอดเงิน: Int หน่วยย่อยที่สุดของสกุลเงินนั้น (ดู lib/money.ts) ──────────
  subtotal            Int
  discountAmount      Int @default(0)
  serviceChargeAmount Int
  vatAmount           Int
  /// มูลค่าสินค้าก่อน VAT — ตัวเลขที่ต้องขึ้นใบกำกับภาษีในบทที่ 12
  netAmount           Int
  grandTotal          Int

  /// เงินสดที่รับมาจริง — null เมื่อจ่ายด้วย QR (ไม่มีการทอน)
  receivedAmount Int?
  changeAmount   Int?

  // snapshot อัตราที่ใช้คิดครั้งนี้ — เหตุผลเดียวกับคอลัมน์ชุดเดียวกันใน Order
  serviceChargeBp  Int
  vatRateBp        Int
  pricesIncludeVat Boolean

  /// อัตราส่วนลดที่ใช้ครั้งนี้ (basis point) — 0 = ไม่มีส่วนลด
  ///
  /// ต้องมีคู่กับ discountAmount ไม่ใช่มีแค่จำนวนเงิน ไม่งั้นใบเสร็จที่พิมพ์ซ้ำ
  /// ปีหน้าจะพิมพ์คำว่า "10%" ไม่ได้ ต้องเดาย้อนจากตัวเลข (เหตุผลเดียวกับ vatRateBp)
  discountBp      Int     @default(0)
  /// พนักงานที่เป็นลูกค้าของบิลนี้ — ตัวที่ทำให้รายงาน "ส่วนลดพนักงานรายคน"
  /// ในบทที่ 15 เป็นไปได้ และเป็นหลักฐานถาวรหลังรอบโต๊ะถูกปิดไปแล้ว
  staffCustomerId String?

  paidByStaffId String?
  /// กะที่รับเงินครั้งนี้อยู่ในนั้น (บทที่ 15)
  ///
  /// nullable เพราะ (1) บิลที่รับก่อนมีระบบกะ และ (2) ร้านที่ยังไม่เปิดกะก็ต้อง
  /// ขายได้ตามปกติ — ระบบกะเป็นเครื่องมือนับเงิน ไม่ใช่ด่านที่ขวางการรับเงิน
  shiftId       String?
  paidAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  branch        Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Restrict: รอบโต๊ะที่จ่ายเงินแล้วห้ามถูกลบจนหลักฐานการรับเงินหายตาม
  tableSession  TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Restrict)
  paidByStaff   Staff?       @relation(fields: [paidByStaffId], references: [id], onDelete: SetNull)
  staffCustomer Staff?       @relation("StaffMealPaidFor", fields: [staffCustomerId], references: [id], onDelete: SetNull)
  /// SetNull: ลบกะทิ้งไม่ได้อยู่แล้วในทางปฏิบัติ แต่ถ้าเกิดขึ้น หลักฐานการรับเงิน
  /// ต้องไม่หายตามไปด้วย (หลักการเดียวกับ paidByStaff)
  shift         Shift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  orders        Order[]
  /// เอกสารที่ออกให้ลูกค้าสำหรับการรับเงินครั้งนี้ — หนึ่งต่อหนึ่งในก้อนนี้
  /// (Restrict ฝั่ง Receipt: ลบการรับเงินทิ้งแล้วเอกสารหายตามไม่ได้)
  receipt       Receipt?

  @@index([branchId, paidAt])
  @@index([tableSessionId])
  @@index([staffCustomerId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// พนักงาน สิทธิ์ และ audit log (บทที่ 13)
// ─────────────────────────────────────────────────────────────────────────────

/// พนักงานหน้าร้าน — ล็อกอินด้วย PIN สั้น ไม่ใช่อีเมล/รหัสผ่าน เพราะต้องกดเร็วหน้าเครื่อง
model Staff {
  id       String @id @default(cuid())
  branchId String
  name     String
  /// รหัสพนักงานที่ใช้พิมพ์คู่กับ PIN — ไม่ซ้ำภายในสาขา
  code     String

  /// เก็บเฉพาะ hash ของ PIN เท่านั้น ห้ามเก็บ PIN ดิบเด็ดขาด
  /// PIN สั้นจึงต้องคู่กับการจำกัดจำนวนครั้งที่กรอกผิด (rate limit ในบทที่ 13)
  pinHash String
  role    StaffRole @default(SERVER)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedSessions    TableSession[]
  placedOrders      Order[]
  auditLogs         AuditLog[]
  payments          Payment[]
  /// บิลที่พนักงานคนนี้เป็น "ลูกค้า" (ส่วนลดพนักงาน — บทที่ 13)
  staffMealSessions TableSession[] @relation("StaffMealCustomer")
  staffMealSetBy    TableSession[] @relation("StaffMealSetBy")
  staffMealPayments Payment[]      @relation("StaffMealPaidFor")
  sessions          StaffSession[]
  /// session ที่พนักงานคนนี้เป็นคน "เตะออก" (คนละคนกับเจ้าของ session)
  revokedSessions   StaffSession[] @relation("StaffSessionRevokedBy")
  openedShifts      Shift[]        @relation("ShiftOpenedBy")
  closedShifts      Shift[]        @relation("ShiftClosedBy")

  @@unique([branchId, code])
  @@index([branchId, isActive])
  @@map("staff")
}

/// บันทึกการกระทำที่สืบสาวย้อนหลังได้ — เคสตัวอย่างในเล่ม: บิลถูก "ยกเลิก"
/// หลังจ่ายเงินไปแล้วไม่กี่นาที ต้องตอบให้ได้ว่าใครกด กดจากเครื่องไหน ตอนกี่โมง
/// ตารางนี้เขียนอย่างเดียว ห้าม update/delete จากโค้ดแอป
model AuditLog {
  id       String  @id @default(cuid())
  branchId String
  staffId  String?

  /// เช่น "order.cancel", "order.discount", "staff.login_failed"
  action     String
  /// ชนิดและ id ของสิ่งที่ถูกกระทำ เก็บเป็น string กว้าง ๆ เพราะครอบหลายตาราง
  entityType String
  entityId   String

  /// ค่าก่อน/หลัง และบริบทอื่น ๆ — Json เพราะรูปร่างต่างกันไปตาม action
  metadata  Json?
  ipAddress String?

  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff  Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([entityType, entityId])
  @@index([staffId])
  @@map("audit_logs")
}

/// Session ของพนักงานที่ "ยกเลิกได้ทันที" (บทที่ 13b)
///
/// ── ทำไมต้องมีตาราง ทั้งที่ cookie เซ็น HMAC ก็พิสูจน์ตัวตนได้อยู่แล้ว ─────────
/// เพราะลายเซ็นตอบได้แค่ว่า "cookie ใบนี้เราออกเองจริง" แต่ตอบไม่ได้ว่า
/// "ตอนนี้ยังใช้ได้อยู่ไหม" — พนักงานที่ถูกไล่ออกตอนบ่ายยังถือ cookie ที่เซ็นไว้
/// ตอนเช้าและใช้ได้จนหมดอายุ 8 ชั่วโมง ซึ่งเป็นช่องที่ปิดไม่ได้เลยถ้าไม่มีที่เก็บสถานะ
///
/// cookie จึงเก็บแค่ id ของแถวนี้ ส่วนคำตอบว่า "ยังใช้ได้ไหม" มาจาก DB ทุก request
/// (แลกด้วย query ที่รวมกับ query Staff เดิมเป็นครั้งเดียวได้)
///
/// แถวนี้ไม่ถูกลบเมื่อล็อกจอ — ตั้ง revokedAt แทน เพื่อให้ยังตอบย้อนหลังได้ว่า
/// เครื่องไหนล็อกอินตอนไหนและถูกปิดด้วยเหตุอะไร (spec §26 Login history)
model StaffSession {
  id       String @id @default(cuid())
  branchId String
  staffId  String

  /// จอที่ session ใบนี้ใช้ได้ — ใบของ POS ใช้เปิด /kds ไม่ได้
  screen StaffScreenKind

  createdAt DateTime @default(now())
  expiresAt DateTime

  /// null = ยังใช้ได้อยู่ · มีค่า = ถูกปิดไปแล้ว (ล็อกจอเอง หรือถูกเตะออก)
  revokedAt        DateTime?
  /// ใครเป็นคนเตะออก — null แปลว่าเจ้าตัวกดล็อกจอเอง
  revokedByStaffId String?
  /// เหตุผลสั้น ๆ เช่น "logout" / "revoked_all" / "pin_reset" / "deactivated"
  revokedReason    String?

  /// IP ตอนล็อกอิน — ต้องมี proxy ที่เชื่อถือได้ข้างหน้าก่อน deploy (lib/server/client-ip.ts)
  ipAddress String?

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff     Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  revokedBy Staff? @relation("StaffSessionRevokedBy", fields: [revokedByStaffId], references: [id], onDelete: SetNull)

  @@index([staffId, revokedAt])
  @@index([branchId, createdAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}

/// ตัวนับ "กรอก PIN ผิด" ที่ทุก instance เห็นตรงกัน (บทที่ 13b)
///
/// เดิมตัวนับอยู่ใน memory ของ process — deploy หลาย instance เมื่อไหร่ คนที่ไล่สุ่ม PIN
/// จะได้โควตาใหม่ทุกครั้งที่ load balancer สลับเครื่องให้ เท่ากับไม่มี rate limit เลย
///
/// ผูกกับ "รหัสพนักงานที่พิมพ์เข้ามา" ไม่ใช่กับ staffId เพราะต้องนับกรณีพิมพ์รหัส
/// ที่ไม่มีอยู่จริงด้วย ไม่งั้นการไล่สุ่มรหัสพนักงานจะไม่ถูกจำกัดเลย
model StaffLoginThrottle {
  id       String @id @default(cuid())
  branchId String

  /// รหัสพนักงานตามที่พิมพ์เข้ามา (trim แล้ว)
  staffCode String

  failedCount Int       @default(0)
  /// ล็อกถึงเมื่อไหร่ — null = ไม่ได้ถูกล็อกอยู่
  lockedUntil DateTime?

  firstFailedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, staffCode])
  @@map("staff_login_throttle")
}

// ─────────────────────────────────────────────────────────────────────────────
// เอกสารที่ออกให้ลูกค้า (บทที่ 12) — ใบเสร็จ / ใบกำกับภาษีอย่างย่อ
// ─────────────────────────────────────────────────────────────────────────────

/// ตัวเดินเลขที่เอกสาร — หนึ่งแถวต่อ (สาขา, ชุดเอกสาร)
///
/// ── ทำไมต้องเป็นตาราง ไม่ใช่ count() หรือ max(seq)+1 ────────────────────────
/// `SELECT max(seq)+1` มีช่องว่างระหว่างอ่านกับเขียน สองเครื่องที่กดพร้อมกันจะได้
/// เลขเดียวกันทั้งคู่ แล้วเครื่องที่สองจะชน unique constraint แล้วการรับเงินล้มเหลว
/// ทั้งที่ลูกค้าจ่ายเงินไปแล้ว — การ `update ... increment` บนแถวเดียวทำให้ Postgres
/// ล็อกแถวนั้นให้เอง เครื่องที่สองรอแล้วได้เลขถัดไป ไม่มีทางได้เลขซ้ำ
///
/// ── ทำไมต้องอยู่ใน transaction เดียวกับการรับเงิน ───────────────────────────
/// เพื่อให้ได้สองสมบัติพร้อมกัน: (1) การรับเงินที่ล้มเหลวจะ rollback การ increment
/// ไปด้วย **เลขจึงไม่ขาดเป็นรู** ซึ่งเป็นสิ่งเดียวที่ตรวจสอบย้อนหลังไม่ผ่านแน่ ๆ
/// และ (2) ไม่มีทางเกิดบิลที่จ่ายเงินแล้วแต่ไม่มีเอกสาร
///
/// ราคาที่จ่าย: การรับเงินของสาขาเดียวกันเข้าคิวกันที่แถวนี้ — เป็นต้นทุนที่
/// หลีกเลี่ยงไม่ได้ของคำว่า "เลขต่อเนื่อง" ไม่ใช่ข้อบกพร่องของ design
model DocumentCounter {
  id       String @id @default(cuid())
  branchId String

  /// ชุดเอกสาร เช่น "ABB" — แยกชุดไว้เผื่อใบลดหนี้/ใบกำกับเต็มรูปในอนาคต
  /// ซึ่งต้องเดินเลขคนละสายกับใบเสร็จ ไม่ใช่ปนกันในสายเดียว
  series  String
  /// เลขล่าสุดที่ออกไปแล้ว — ใบถัดไปคือ lastSeq + 1 (เริ่มที่ 0 แปลว่ายังไม่เคยออกใบ)
  lastSeq Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, series])
  @@map("document_counters")
}

/// เอกสารหนึ่งใบที่ออกให้ลูกค้า
///
/// ── ทำไมแยกจาก Payment ────────────────────────────────────────────────────
/// `Payment` = **เงินที่ได้รับ** · `Receipt` = **เอกสารที่ออกให้** คนละเรื่องกัน
/// แยกแล้วได้สามอย่างที่รวมกันแล้วทำไม่ได้:
///
///   1. snapshot ตัวตนผู้ขาย ณ วันที่ออกใบ — ร้านเปลี่ยนชื่อ ย้ายที่อยู่ หรือเพิ่งได้
///      เลขผู้เสียภาษีมาทีหลังได้ แต่ใบที่พิมพ์ซ้ำปีหน้า **ต้องเหมือนใบที่ลูกค้าถืออยู่**
///      (กฎเดียวกับที่ห้ามอ่านอัตรา VAT จาก Branch ตอนพิมพ์ใบเก่า)
///   2. นับและสืบการพิมพ์ซ้ำได้ ซึ่งไม่ใช่ข้อมูลการเงินและไม่ควรอยู่ในตารางเงิน
///   3. ใบลดหนี้ตอนทำ Refund ในอนาคตจะเป็น Receipt **อีกแถวที่อ้างถึงใบเดิม**
///      ไม่ใช่การแก้ใบเก่า — โครงนี้รองรับตั้งแต่ต้นโดยไม่ต้อง migrate ซ้ำ
model Receipt {
  id        String @id @default(cuid())
  branchId  String
  paymentId String @unique

  series String
  seq    Int
  /// เลขที่ที่พิมพ์ลงใบจริง เช่น "HQ-00000123" — ประกอบไว้แล้วเพื่อให้ค้นด้วยสิ่งที่
  /// ลูกค้าอ่านจากใบในมือได้ตรง ๆ โดยไม่ต้องแยกส่วนก่อน
  ///
  /// unique **ต่อสาขา ไม่ใช่ทั้งระบบ** — Branch.code ไม่ซ้ำแค่ภายใน tenant เดียวกัน
  /// (@@unique([tenantId, code])) สอง tenant จึงมีสาขาชื่อ "HQ" ได้ทั้งคู่ แล้วเลขที่
  /// จะชนกันข้ามร้านทั้งที่ไม่เกี่ยวอะไรกันเลย ถ้าตั้ง unique ทั้งระบบ
  number String
  kind   ReceiptKind

  // ── snapshot ตัวตนผู้ขาย ณ วันที่ออกใบ — ห้าม join Tenant/Branch สดตอนพิมพ์ซ้ำ ──
  sellerName       String
  /// เลขประจำตัวผู้เสียภาษี 13 หลัก — null ได้เมื่อ kind = RECEIPT (สาขานอกไทย)
  sellerTaxId      String?
  sellerBranchName String
  sellerAddress    String?
  sellerPhone      String?
  /// ข้อความท้ายใบ ณ วันที่ออก — ร้านเปลี่ยนข้อความแล้วใบเก่าต้องพิมพ์ออกมาเหมือนเดิม
  /// (เหตุผลเดียวกับ sellerName/sellerAddress ที่อยู่ในกลุ่มเดียวกันนี้)
  sellerFooter     String?

  issuedAt DateTime @default(now())

  /// จำนวนครั้งที่กดปุ่มพิมพ์ — 0 = ออกใบแล้วแต่ยังไม่เคยพิมพ์
  /// ครั้งที่ 2 ขึ้นไปต้องขึ้นคำว่า "สำเนา" บนหัวใบ (ต้นฉบับมีใบเดียวเสมอ)
  ///
  /// นับจาก **ปุ่ม** ไม่ใช่ `onafterprint` ของเบราว์เซอร์ เพราะ event นั้นยิงตอน
  /// ผู้ใช้กด Ctrl+P เองด้วย และแต่ละเบราว์เซอร์ยิงไม่เหมือนกัน — แค่ "เปิดหน้าดู"
  /// ไม่ควรถูกนับว่าออกสำเนาให้ลูกค้า
  printCount     Int       @default(0)
  firstPrintedAt DateTime?
  lastPrintedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Restrict: ลบการรับเงินทิ้งแล้วเอกสารที่ออกให้ลูกค้าหายตามไม่ได้
  /// (ทุกที่ที่ล้างโต๊ะจึงต้องลบตามลำดับ ใบเสร็จ → การรับเงิน → รอบโต๊ะ)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([branchId, series, seq])
  @@unique([branchId, number])
  @@index([branchId, issuedAt])
  @@map("receipts")
}

/// กะการขาย (บทที่ 15) — ช่วงเวลาที่ "ลิ้นชักเงินใบหนึ่งอยู่ในความรับผิดชอบของคนหนึ่ง"
///
/// ── ทำไมกะไม่ใช่ "วัน" ──────────────────────────────────────────────────
/// ร้านที่ปิดตีสองมีบิลคร่อมเที่ยงคืนทุกวัน และร้านที่เปิดสองกะเปลี่ยนคนถือเงิน
/// กลางวัน — การนับเงินสดต้องเทียบกับ "ช่วงที่คนนั้นรับผิดชอบ" ไม่ใช่ช่วงวันปฏิทิน
/// จึงอ้างเวลาเปิด/ปิดจริงของแถวนี้ ไม่ใช่คำนวณจากวันที่ (ดู lib/server/branch-time.ts)
///
/// ── ตัวเลขถูก snapshot ตอนปิดกะ ห้ามคำนวณสดตอนเปิดดูย้อนหลัง ──────────
/// รายงานปิดกะคือเอกสารที่ใช้เทียบกับเงินในลิ้นชัก ณ นาทีที่นับ ถ้าคำนวณใหม่ทุกครั้ง
/// ที่เปิดดู ตัวเลขจะขยับตามบิลที่ถูกแก้/ยกเลิกทีหลัง แล้วส่วนต่างที่เคยเซ็นรับไว้
/// จะอธิบายไม่ได้ (หลักการเดียวกับ snapshot ใน Payment/Receipt บทที่ 11-12)
model Shift {
  id       String @id @default(cuid())
  branchId String

  status ShiftStatus @default(OPEN)

  openedAt        DateTime @default(now())
  openedByStaffId String?
  /// เงินทอนตั้งต้นในลิ้นชักตอนเปิดกะ — หน่วยย่อยที่สุดของสกุลเงินสาขา
  openingFloat    Int      @default(0)

  closedAt        DateTime?
  closedByStaffId String?

  // ── ตัวเลขที่ snapshot ตอนปิดกะ (null ตราบใดที่กะยังเปิดอยู่) ──────────────
  /// เงินสดที่นับได้จริงในลิ้นชัก
  countedCash    Int?
  /// เงินสดที่ระบบคาดว่าควรมี = เงินทอนตั้งต้น + ยอดขายเงินสดในกะนี้
  expectedCash   Int?
  /// countedCash - expectedCash · บวก = เกิน · ลบ = ขาด
  cashDifference Int?

  /// ยอดขายรวมทุกช่องทางในกะนี้ (รวม VAT/ค่าบริการแล้ว)
  salesTotal Int?
  /// จำนวนบิลที่ปิดในกะนี้
  billCount  Int?
  /// สรุปแยกช่องทางรับเงิน/ช่องทางขาย ณ ตอนปิด — เก็บเป็น Json เพราะรูปร่าง
  /// จะเปลี่ยนไปตามช่องทางที่ร้านเปิดใช้ และเป็นข้อมูลอ่านอย่างเดียว
  breakdown  Json?

  /// หมายเหตุตอนปิดกะ เช่น "ลูกค้าจ่ายเกินแล้วไม่รับทอน 20 บาท"
  note String?

  branch        Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  openedByStaff Staff? @relation("ShiftOpenedBy", fields: [openedByStaffId], references: [id], onDelete: SetNull)
  closedByStaff Staff? @relation("ShiftClosedBy", fields: [closedByStaffId], references: [id], onDelete: SetNull)

  payments Payment[]

  @@index([branchId, openedAt])
  @@index([branchId, status])
  @@map("shifts")
}

enum ShiftStatus {
  OPEN
  CLOSED
}
