{
  "name": "pos-restaurant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke:order": "tsx --conditions=react-server scripts/smoke-customer-order.ts",
    "smoke:pos": "tsx --conditions=react-server scripts/smoke-pos-staff.ts",
    "smoke:kds": "tsx --conditions=react-server scripts/smoke-kds.ts",
    "smoke:bill": "tsx --conditions=react-server scripts/smoke-bill.ts",
    "smoke:payment": "tsx --conditions=react-server scripts/smoke-payment.ts",
    "smoke:menu": "tsx --conditions=react-server scripts/smoke-menu.ts",
    "dev:session": "tsx --conditions=react-server scripts/dev-open-session.ts",
    "dev:staff-cookie": "tsx --conditions=react-server scripts/dev-staff-cookie.ts",
    "dev:reset-table": "tsx --conditions=react-server scripts/dev-reset-table.ts",
    "dev:emit": "tsx --conditions=react-server scripts/dev-emit-event.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "smoke:receipt": "tsx --conditions=react-server scripts/smoke-receipt.ts",
    "smoke:staff-meal": "tsx --conditions=react-server scripts/smoke-staff-meal.ts",
    "smoke:takeaway": "tsx --conditions=react-server scripts/smoke-takeaway.ts",
    "audit:screens": "node scripts/audit-screens.mjs",
    "smoke:staff-session": "tsx --conditions=react-server scripts/smoke-staff-session.ts",
    "smoke:staff-admin": "tsx --conditions=react-server scripts/smoke-staff-admin.ts",
    "smoke:settings": "tsx --conditions=react-server scripts/smoke-settings.ts",
    "smoke:dashboard": "tsx --conditions=react-server scripts/smoke-dashboard.ts",
    "smoke:table-move": "tsx --conditions=react-server scripts/smoke-table-move.ts",
    "smoke:tables": "tsx --conditions=react-server scripts/smoke-tables.ts",
    "smoke:i18n": "tsx --conditions=react-server scripts/smoke-i18n.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.23.1",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
