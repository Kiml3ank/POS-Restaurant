# ---------------------------------------------------------------------------
# Dev database — PostgreSQL 17 ที่รันด้วย docker-compose (ดู CLAUDE.md หัวข้อ 2.1)
# สั่ง `npm run db:up` ก่อน แล้วค่อย `npx prisma migrate dev`
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ---------------------------------------------------------------------------
# กุญแจสำหรับเซ็น cookie ล็อกอินพนักงาน (POS/KDS/admin) — บทที่ 9 + 13
# สร้างใหม่ด้วย: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่ม 32 ไบต์"

# ---------------------------------------------------------------------------
# ท่อ realtime ของจอครัว/ผังโต๊ะ/หน้าติดตามออร์เดอร์ — บทที่ 8
#
#   memory   (ค่าเริ่มต้น ไม่ต้องตั้ง) ใช้ EventEmitter ใน process เดียว
#            พอสำหรับ `next dev` และการ deploy แบบ instance เดียว
#   postgres ใช้ LISTEN/NOTIFY ของ Postgres เป็นที่นัดพบกลาง
#            **ต้องเปิดค่านี้ก่อน deploy แบบหลาย instance (เช่น Vercel)**
#            ไม่งั้นจอครัวที่เสียบอยู่กับ instance B จะไม่เห็นออร์เดอร์ที่เข้า instance A
#
# ดู lib/server/realtime.ts
# ---------------------------------------------------------------------------
# REALTIME_DRIVER="postgres"
