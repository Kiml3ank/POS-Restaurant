# ---------------------------------------------------------------------------
# Dev database — PostgreSQL 17 ที่รันด้วย docker-compose (ดู CLAUDE.md หัวข้อ 2.1)
# สั่ง `npm run db:up` ก่อน แล้วค่อย `npx prisma migrate dev`
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ---------------------------------------------------------------------------
# กุญแจสำหรับเซ็น cookie ล็อกอินพนักงาน (POS/KDS/admin) — บทที่ 9 + 13
# สร้างใหม่ด้วย: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่ม 32 ไบต์"
